---
const navLinks = [
  { href: '/', label: '首頁' },
  { href: '/services', label: '服務項目' },
  { href: '/about', label: '關於我們' },
  { href: '/contact', label: '聯絡我們' },
];

const currentPath = Astro.url.pathname;
---

<header id="mainHeader" class="sticky top-0 z-[1000] bg-white/95 backdrop-blur-sm transition-all duration-300 border-b border-transparent">
  <div class="container-main">
    <nav class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <svg class="w-8 h-8 text-primary" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 28V12l12-8 12 8v16H4z"/>
          <path d="M12 28v-8h8v8"/>
          <rect x="14" y="16" width="4" height="4" rx="0.5"/>
        </svg>
        <span class="text-primary font-bold text-lg tracking-tight">9458專業搬家</span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-8">
        {navLinks.map(link => (
          <a 
            href={link.href} 
            class={`nav-link ${currentPath === link.href ? 'text-accent' : ''}`}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- CTA Button -->
      <div class="hidden md:block">
        <a href="/contact" class="bg-accent text-white text-sm font-medium px-5 py-2 rounded hover:brightness-110 transition-all duration-200">
          免費估價
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button 
        id="mobileMenuBtn" 
        class="md:hidden p-2 text-primary"
        aria-label="開啟選單"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div id="mobileMenu" class="md:hidden hidden bg-white border-t border-border">
    <div class="container-main py-4 space-y-3">
      {navLinks.map(link => (
        <a 
          href={link.href} 
          class="block py-2 text-primary font-medium hover:text-accent transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a href="/contact" class="block bg-accent text-white text-center font-medium px-5 py-3 rounded mt-4">
        免費估價
      </a>
    </div>
  </div>
</header>

<script>
  // Header scroll behavior
  const header = document.getElementById('mainHeader');
  if (header) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 100) {
        header.classList.add('bg-white', 'border-border');
        header.classList.remove('bg-white/95', 'border-transparent');
      } else {
        header.classList.remove('bg-white', 'border-border');
        header.classList.add('bg-white/95', 'border-transparent');
      }
    });
  }

  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>