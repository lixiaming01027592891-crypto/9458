---
const services = [
  {
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 40V20l16-10 16 10v20H8z"/>
      <path d="M18 40V28h12v12"/>
      <rect x="21" y="16" width="6" height="6" rx="1"/>
      <path d="M4 20h40"/>
    </svg>`,
    title: '住宅搬家',
    description: '套房搬家、透天厝、大樓公寓，精緻搬家與經濟型搬家任您選擇。24小時服務，夜間搬遷也能配合。',
    link: '/services'
  },
  {
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="6" y="8" width="36" height="32" rx="2"/>
      <path d="M6 16h36"/>
      <path d="M16 16v24"/>
      <path d="M32 16v24"/>
      <rect x="20" y="12" width="8" height="2" rx="1"/>
    </svg>`,
    title: '商業搬遷',
    description: '公司搬遷、辦公室搬家、工廠搬遷。專業規劃搬遷動線，最小化營業中斷時間。',
    link: '/services'
  },
  {
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 40V28c0-8 4-16 16-16s16 8 16 16v12"/>
      <path d="M16 40V28c0-5 3-10 8-10"/>
      <rect x="20" y="8" width="8" height="6" rx="1"/>
      <line x1="24" y1="4" x2="24" y2="8"/>
    </svg>`,
    title: '特殊物品搬運',
    description: '鋼琴載運及包裝防護、冰箱背負搬運、書櫃樓梯搬運。專業器材，細心呵護您的每一件珍藏。',
    link: '/services'
  }
];
---

<section class="py-20 bg-white" id="services">
  <div class="container-main">
    <!-- Section Header -->
    <div class="text-center mb-14">
      <p class="section-title">我們的服務</p>
      <h2 class="section-heading">專業搬家服務，滿足各種需求</h2>
    </div>

    <!-- Service Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {services.map(service => (
        <div class="group bg-white border border-border rounded-lg p-8 transition-all duration-300 hover:border-primary hover:-translate-y-1 hover:shadow-[0_8px_24px_rgba(0,20,73,0.08)]">
          <!-- Icon -->
          <div class="w-12 h-12 text-primary transition-colors duration-300 group-hover:text-accent mb-5">
            <Fragment set:html={service.icon} />
          </div>
          
          <!-- Title -->
          <h3 class="text-xl font-bold text-primary mb-3">{service.title}</h3>
          
          <!-- Description -->
          <p class="text-muted text-sm leading-relaxed mb-5">{service.description}</p>
          
          <!-- Link -->
          <a href={service.link} class="inline-flex items-center gap-1 text-accent text-sm font-medium hover:gap-2 transition-all duration-200">
            了解詳情
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Intersection Observer for fade-in animation
  const observerOptions = {
    threshold: 0.2,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, index) => {
      if (entry.isIntersecting) {
        setTimeout(() => {
          entry.target.classList.add('opacity-100', 'translate-y-0');
          entry.target.classList.remove('opacity-0', 'translate-y-6');
        }, index * 150);
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('#services .group').forEach(card => {
    card.classList.add('opacity-0', 'translate-y-6', 'transition-all', 'duration-500');
    observer.observe(card);
  });
</script>