---
const serviceLinks = [
  { href: '/services', label: '住宅搬家' },
  { href: '/services', label: '商業搬遷' },
  { href: '/services', label: '特殊物品' },
  { href: '/services', label: '廢棄物清運' },
];

const companyLinks = [
  { href: '/about', label: '關於我們' },
  { href: '/about', label: '搬家實錄' },
  { href: '/contact', label: '聯絡我們' },
];
---

<footer class="bg-primary-dark text-white/80">
  <div class="container-main pt-16 pb-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4">
          <svg class="w-8 h-8 text-white" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 28V12l12-8 12 8v16H4z"/>
            <path d="M12 28v-8h8v8"/>
            <rect x="14" y="16" width="4" height="4" rx="0.5"/>
          </svg>
          <span class="text-white font-bold text-lg">9458專業搬家</span>
        </a>
        <p class="text-sm leading-relaxed mb-4">
          台南在地專業搬家公司，年輕團隊，價格公道，服務細心。
        </p>
        <p class="text-sm">
          <span class="inline-block w-4 h-4 mr-1 align-text-bottom">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </span>
          70846 台南市安平區建平一街190巷16號
        </p>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-white font-bold mb-4">服務項目</h4>
        <ul class="space-y-2">
          {serviceLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm hover:text-accent transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-white font-bold mb-4">公司資訊</h4>
        <ul class="space-y-2">
          {companyLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm hover:text-accent transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-white font-bold mb-4">聯絡我們</h4>
        <ul class="space-y-3">
          <li>
            <a href="tel:0977184903" class="text-sm hover:text-accent transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              0977-184-903
            </a>
          </li>
          <li class="flex items-center gap-3 pt-2">
            <a href="https://line.me/ti/p/q0wNmcOv8D" target="_blank" rel="noopener noreferrer" 
               class="w-10 h-10 rounded-full bg-line flex items-center justify-center hover:brightness-110 transition-all"
               aria-label="LINE">
              <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5-4.771c0 .345-.282.63-.631.63-.345 0-.627-.285-.627-.63V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-.627 6.247c-.24 0-.44-.162-.518-.381l-.41-1.205H6.59l-.408 1.205c-.078.219-.279.381-.518.381a.596.596 0 01-.199-.034.629.629 0 01-.349-.797l1.645-4.613c.086-.24.287-.401.518-.401.232 0 .432.161.518.401l1.644 4.613a.624.624 0 01-.349.797.586.586 0 01-.2.034zm-1.353-4.63l-.589 1.738h1.178l-.589-1.738zm-3.23.512v3.537c0 .345-.282.63-.631.63-.345 0-.626-.285-.626-.63v-3.537H3.085c-.345 0-.625-.285-.625-.63 0-.345.28-.63.625-.63h3.07c.349 0 .63.285.63.63 0 .345-.281.63-.63.63h-.706v.001zM24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.686.391.084.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
              </svg>
            </a>
            <a href="https://www.facebook.com/354589795267116" target="_blank" rel="noopener noreferrer"
               class="w-10 h-10 rounded-full bg-[#1877F2] flex items-center justify-center hover:brightness-110 transition-all"
               aria-label="Facebook">
              <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a href="https://www.instagram.com/zxc7370808" target="_blank" rel="noopener noreferrer"
               class="w-10 h-10 rounded-full bg-gradient-to-br from-[#F58529] via-[#DD2A7B] to-[#8134AF] flex items-center justify-center hover:brightness-110 transition-all"
               aria-label="Instagram">
              <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-white/50">
        &copy; 2026 9458專業搬家 All rights reserved.
      </p>
      <a href="#" class="text-xs text-white/50 hover:text-accent transition-colors">
        隱私政策
      </a>
    </div>
  </div>
</footer>