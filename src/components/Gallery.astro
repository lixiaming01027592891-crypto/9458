---
const images = [
  {
    src: '/images/gallery-piano.jpg',
    alt: '專業運載及包裝防護',
    label: '專業運載及包裝防護'
  },
  {
    src: '/images/gallery-sofa-stairs.jpg',
    alt: '沙發樓梯搬運',
    label: '沙發樓梯搬運'
  },
  {
    src: '/images/gallery-sofa-lshape.jpg',
    alt: 'L型沙發拆裝搬運',
    label: 'L型沙發拆裝搬運'
  },
  {
    src: '/images/gallery-fridge.jpg',
    alt: '冰箱背負搬運',
    label: '冰箱背負搬運'
  },
  {
    src: '/images/gallery-bookshelf.jpg',
    alt: '書櫃搬運',
    label: '書櫃搬運'
  },
  {
    src: '/images/gallery-truck.jpg',
    alt: '車輛堆疊專業裝載',
    label: '車輛堆疊專業裝載'
  }
];
---

<section class="py-20 bg-white">
  <div class="container-main">
    <!-- Section Header -->
    <div class="text-center mb-14">
      <p class="section-title">搬家實錄</p>
      <h2 class="section-heading">專業的搬家陣容，絕對是您最優質的選擇</h2>
    </div>

    <!-- Photo Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
      {images.map((img, index) => (
        <div class="gallery-item group relative overflow-hidden rounded-lg cursor-pointer" data-index={index}>
          <img 
            src={img.src} 
            alt={img.alt}
            class="w-full aspect-[4/3] object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            width="400"
            height="300"
          />
          <!-- Hover Overlay -->
          <div class="absolute inset-0 bg-primary/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
            </svg>
          </div>
          <!-- Label -->
          <div class="absolute bottom-0 left-0 right-0 p-3 bg-gradient-to-t from-black/60 to-transparent">
            <p class="text-white text-xs">{img.label}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Lightbox -->
<div id="lightbox" class="fixed inset-0 z-[2000] bg-black/90 hidden items-center justify-center p-4">
  <button id="lightboxClose" class="absolute top-4 right-4 text-white/80 hover:text-white p-2" aria-label="關閉">
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>
  <img id="lightboxImg" src="" alt="" class="max-w-full max-h-[85vh] object-contain rounded" />
  <p id="lightboxCaption" class="absolute bottom-6 left-0 right-0 text-center text-white/80 text-sm"></p>
</div>

<script>
  // Gallery fade-in
  const galleryObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry, index) => {
      if (entry.isIntersecting) {
        setTimeout(() => {
          entry.target.classList.add('opacity-100', 'translate-y-0');
          entry.target.classList.remove('opacity-0', 'translate-y-6');
        }, index * 100);
        galleryObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.gallery-item').forEach(item => {
    item.classList.add('opacity-0', 'translate-y-6', 'transition-all', 'duration-500');
    galleryObserver.observe(item);
  });

  // Lightbox
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement;
  const lightboxCaption = document.getElementById('lightboxCaption');
  const lightboxClose = document.getElementById('lightboxClose');

  document.querySelectorAll('.gallery-item').forEach(item => {
    item.addEventListener('click', () => {
      const img = item.querySelector('img');
      const label = item.querySelector('.text-white')?.textContent;
      if (img && lightboxImg && lightbox && lightboxCaption) {
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt;
        lightboxCaption.textContent = label || '';
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    }
  }

  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>