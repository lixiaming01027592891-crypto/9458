---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CTA from '@/components/CTA.astro';

const title = '搬家攻略 | 專業搬家知識分享 | 9458專業搬家';
const description = '9458專業搬家為您提供專業的搬家知識與攻略，包含搬家前準備、打包技巧、費用說明、各區域搬家須知等實用資訊。';

const posts = await getCollection('blog');
// Sort by publishDate descending
posts.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
---

<Layout title={title} description={description}>
  <Header />

  <main>
    <!-- Page Header -->
    <section class="bg-primary pt-16 pb-20 relative overflow-hidden">
      <div class="absolute bottom-0 right-0 w-64 h-32 opacity-20">
        <svg viewBox="0 0 256 128" fill="none" class="w-full h-full">
          <path d="M0,64 C40,20 80,100 128,64 C176,28 216,108 256,64" stroke="white" stroke-width="2" fill="none"/>
        </svg>
      </div>
      <div class="container-main relative z-10">
        <nav class="text-white/60 text-sm mb-4">
          <a href="/" class="hover:text-white transition-colors">首頁</a>
          <span class="mx-2">&gt;</span>
          <span>搬家攻略</span>
        </nav>
        <h1 class="text-white text-3xl lg:text-4xl font-bold">搬家攻略</h1>
        <p class="text-white/70 mt-3 max-w-xl">
          專業搬家知識與實用技巧分享，讓您的搬遷過程更順利。
        </p>
      </div>
    </section>

    <!-- Blog List -->
    <section class="py-20 bg-white">
      <div class="container-main">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="blogGrid">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="group bg-white border border-border rounded-lg overflow-hidden hover:border-primary hover:shadow-lg transition-all duration-300">
              {post.data.coverImage && (
                <div class="aspect-video overflow-hidden">
                  <img 
                    src={post.data.coverImage} 
                    alt={post.data.coverAlt || post.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    width="400"
                    height="225"
                  />
                </div>
              )}
              <div class="p-6">
                <div class="flex items-center gap-3 text-xs text-muted mb-3">
                  <span>{post.data.publishDate}</span>
                  <span>|</span>
                  <span>{post.data.readTime}閱讀</span>
                </div>
                <h2 class="text-lg font-bold text-primary group-hover:text-accent transition-colors mb-3 line-clamp-2">
                  {post.data.title}
                </h2>
                <p class="text-muted text-sm line-clamp-3">
                  {post.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <CTA />
  </main>

  <Footer />
</Layout>
