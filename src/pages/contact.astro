---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const title = '聯絡我們 | 9458專業搬家 - 免費到府估價';
const description = '聯絡9458專業搬家，預約免費到府估價。電話：0977-184-903。地址：台南市安平區建平一街190巷16號。24小時營業，全年無休。';
---

<Layout title={title} description={description}>
  <Header />
  
  <main>
    <!-- Page Header -->
    <section class="bg-primary pt-16 pb-20 relative overflow-hidden">
      <div class="absolute bottom-0 right-0 w-64 h-32 opacity-20">
        <svg viewBox="0 0 256 128" fill="none" class="w-full h-full">
          <path d="M0,64 C40,20 80,100 128,64 C176,28 216,108 256,64" stroke="white" stroke-width="2" fill="none"/>
        </svg>
      </div>
      <div class="container-main relative z-10">
        <nav class="text-white/60 text-sm mb-4">
          <a href="/" class="hover:text-white transition-colors">首頁</a>
          <span class="mx-2">&gt;</span>
          <span>聯絡我們</span>
        </nav>
        <h1 class="text-white text-3xl lg:text-4xl font-bold">聯絡我們</h1>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="py-20 bg-white">
      <div class="container-main">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
          <!-- Contact Info -->
          <div>
            <h2 class="text-2xl lg:text-3xl font-bold text-primary mb-8">
              搬家這檔事，<br class="hidden sm:block"/>交給 9458 就對了
            </h2>
            
            <div class="space-y-6">
              <!-- Phone -->
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-muted text-sm mb-1">聯絡電話</p>
                  <a href="tel:0977184903" class="text-accent text-2xl font-bold hover:brightness-110 transition-all">
                    0977-184-903
                  </a>
                </div>
              </div>
              
              <!-- Address -->
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-muted text-sm mb-1">公司地址</p>
                  <p class="text-primary font-medium">70846 台南市安平區建平一街190巷16號</p>
                </div>
              </div>
              
              <!-- Hours -->
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-muted text-sm mb-1">營業時間</p>
                  <p class="text-primary font-medium">24小時營業 · 全年無休</p>
                </div>
              </div>
            </div>
            
            <!-- Social Links -->
            <div class="mt-10">
              <p class="text-muted text-sm mb-4">社群媒體</p>
              <div class="flex items-center gap-3">
                <a href="https://line.me/ti/p/q0wNmcOv8D" target="_blank" rel="noopener noreferrer"
                   class="w-12 h-12 rounded-full bg-line flex items-center justify-center hover:brightness-110 transition-all"
                   aria-label="LINE">
                  <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5-4.771c0 .345-.282.63-.631.63-.345 0-.627-.285-.627-.63V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-.627 6.247c-.24 0-.44-.162-.518-.381l-.41-1.205H6.59l-.408 1.205c-.078.219-.279.381-.518.381a.596.596 0 01-.199-.034.629.629 0 01-.349-.797l1.645-4.613c.086-.24.287-.401.518-.401.232 0 .432.161.518.401l1.644 4.613a.624.624 0 01-.349.797.586.586 0 01-.2.034zm-1.353-4.63l-.589 1.738h1.178l-.589-1.738zm-3.23.512v3.537c0 .345-.282.63-.631.63-.345 0-.626-.285-.626-.63v-3.537H3.085c-.345 0-.625-.285-.625-.63 0-.345.28-.63.625-.63h3.07c.349 0 .63.285.63.63 0 .345-.281.63-.63.63h-.706v.001zM24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.686.391.084.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
                  </svg>
                </a>
                <a href="https://www.facebook.com/354589795267116" target="_blank" rel="noopener noreferrer"
                   class="w-12 h-12 rounded-full bg-[#1877F2] flex items-center justify-center hover:brightness-110 transition-all"
                   aria-label="Facebook">
                  <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </a>
                <a href="https://www.instagram.com/zxc7370808" target="_blank" rel="noopener noreferrer"
                   class="w-12 h-12 rounded-full bg-gradient-to-br from-[#F58529] via-[#DD2A7B] to-[#8134AF] flex items-center justify-center hover:brightness-110 transition-all"
                   aria-label="Instagram">
                  <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
          
          <!-- Contact Form -->
          <div class="bg-surface rounded-lg p-8 lg:p-10">
            <h3 class="text-xl font-bold text-primary mb-6">快速諮詢</h3>
            
            <form class="space-y-5" onsubmit="event.preventDefault(); alert('感謝您的諮詢！我們會盡快與您聯繫。');">
              <div>
                <label for="name" class="block text-sm text-primary font-medium mb-2">姓名</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required
                  class="w-full px-4 py-3 bg-white border border-border rounded focus:border-primary focus:outline-none transition-colors text-primary"
                  placeholder="請輸入您的姓名"
                />
              </div>
              
              <div>
                <label for="phone" class="block text-sm text-primary font-medium mb-2">聯絡電話</label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  required
                  class="w-full px-4 py-3 bg-white border border-border rounded focus:border-primary focus:outline-none transition-colors text-primary"
                  placeholder="請輸入聯絡電話"
                />
              </div>
              
              <div>
                <label for="type" class="block text-sm text-primary font-medium mb-2">搬家類型</label>
                <select 
                  id="type" 
                  name="type" 
                  required
                  class="w-full px-4 py-3 bg-white border border-border rounded focus:border-primary focus:outline-none transition-colors text-primary"
                >
                  <option value="">請選擇搬家類型</option>
                  <option value="residential">住宅搬家</option>
                  <option value="commercial">商業搬遷</option>
                  <option value="special">特殊物品</option>
                  <option value="other">其他</option>
                </select>
              </div>
              
              <div>
                <label for="area" class="block text-sm text-primary font-medium mb-2">搬家區域</label>
                <input 
                  type="text" 
                  id="area" 
                  name="area"
                  class="w-full px-4 py-3 bg-white border border-border rounded focus:border-primary focus:outline-none transition-colors text-primary"
                  placeholder="例如：台南安平區 → 台南南區"
                />
              </div>
              
              <div>
                <label for="message" class="block text-sm text-primary font-medium mb-2">備註</label>
                <textarea 
                  id="message" 
                  name="message" 
                  rows="4"
                  class="w-full px-4 py-3 bg-white border border-border rounded focus:border-primary focus:outline-none transition-colors text-primary resize-none"
                  placeholder="請描述您的搬家需求（樓層、有無電梯、特殊物品等）"
                ></textarea>
              </div>
              
              <button 
                type="submit" 
                class="w-full bg-accent text-white font-medium py-4 rounded hover:brightness-110 transition-all duration-200"
              >
                送出諮詢
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- Map Section -->
    <section class="bg-surface">
      <div class="container-main py-0">
        <div class="rounded-lg overflow-hidden shadow-sm">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3671.693!2d120.1601!3d22.9986!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjLCsDU5JzU0LjkiTiAxMjDCsDA5JzM2LjQiRQ!5e0!3m2!1szh-TW!2stw!4v1"
            width="100%"
            height="400"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="9458專業搬家位置地圖"
            class="w-full"
          ></iframe>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>